      - name: Build APK
        run: |
          FILE=$(find source -type f \( \
            -name settings.gradle -o \
            -name settings.gradle.kts \
          \) | head -n 1)

          if [ -z "$FILE" ]; then
            echo "Gradle project not found"
            exit 1
          fi

          DIR=$(dirname "$FILE")
          cd "$DIR"

          if [ -f "./gradlew" ]; then
            chmod +x gradlew
            ./gradlew assembleDebug
          else
            gradle assembleDebug
          fi
